extends ../layout.pug
block content
	div.container.shop-showcase
			#carouselExample.carousel.slide.custom-carousel.col
				.carousel-inner
					.carousel-item.active
						img(src='public/kb.png' alt='...')
					.carousel-item
						img(src='public/kb2.png' alt='...')
				button.carousel-control-prev(type='button' data-bs-target='#carouselExample' data-bs-slide='prev')
					span.carousel-control-prev-icon(aria-hidden='true')
					span.visually-hidden Previous
				button.carousel-control-next(type='button' data-bs-target='#carouselExample' data-bs-slide='next')
					span.carousel-control-next-icon(aria-hidden='true')
					span.visually-hidden Next
			div.d-flex.w-100.flex-column.gap-2.col
					h1.font-monospace New Keyboard 2
					h5.display-2.font-monospace Look Very Cool and Feel Very Good
					hr.border-black.opacity-100
